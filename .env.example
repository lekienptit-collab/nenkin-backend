# ---- App ----
# Luu y: tren may nay cong 3000 va 3001 dang bi ung dung khac chiem,
# .env dang dung 3900. Doi lai neu may ban trong cong 3000.
PORT=3000
NODE_ENV=development
RUN_ENV=dev
IS_SWAGGER=true

# ---- Database (MySQL) ----
DATABASE_TYPE=mysql
DATABASE_HOST=127.0.0.1
DATABASE_PORT=33062
DATABASE_USERNAME=root
DATABASE_PASSWROD=nenkin
DATABASE_NAME=nenkin
DATABASE_LOGGING=true
DATABASE_POOL_SIZE=30
SLOW_QUERY_THRESHOLD=1000
# false = dùng migration (khuyến nghị). true = TypeORM tự đồng bộ schema,
# tiện lúc mới dựng nhưng sẽ khiến migrate:generate không phát hiện thay đổi nào.
DATABASE_SYNCHRONIZE=false

# ---- Redis (cache) ----
REDIS_HOST=127.0.0.1
REDIS_PORT=63792
REDIS_PASSWORD=
REDIS_DB=0

# ---- JWT ----
JWT_SECRET=change-this-jwt-secret
JWT_LIFETIME=3600
JWT_RF_LIFETIME=2592000

# ---- Tài khoản admin khởi tạo lần đầu ----
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@nenkin.local
ADMIN_PASSWORD=Admin@123

# ---- Kho file (anh giay to, PDF ho so Nenkin) ----
# Mac dinh: <thu muc backend>/storage
STORAGE_ROOT=
STORAGE_PUBLIC_PATH=/media
STORAGE_MAX_FILE_SIZE=10485760

# ---- OCR doc giay to bang AI (Groq) ----
# Lay API key tai https://console.groq.com/keys
# De trong = tat tinh nang OCR, moi truong van nhap tay binh thuong.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Model bat buoc phai nhan anh (input_modalities co "image")
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=60000
GROQ_MAX_RETRIES=2
